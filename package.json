{
  "name": "bcra-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web pública del Repositorio BCRA (Evidence clásico, sitio estático)",
  "scripts": {
    "build": "evidence build && node scripts/wasm-cdn.mjs",
    "build:strict": "evidence build:strict && node scripts/wasm-cdn.mjs",
    "dev": "evidence dev --open /",
    "sources": "evidence sources",
    "sources:strict": "evidence sources --strict",
    "preview": "evidence preview"
  },
  "engines": {
    "npm": ">=7.0.0",
    "node": ">=18.0.0"
  },
  "type": "module",
  "dependencies": {
    "@evidence-dev/core-components": "5.4.2",
    "@evidence-dev/duckdb": "2.0.1",
    "@evidence-dev/evidence": "40.1.8"
  },
  "overrides": {
    "jsonwebtoken": "9.0.0",
    "trim@<0.0.3": ">0.0.3",
    "axios": "^1.7.4"
  },
  "devDependencies": {
    "typescript": "5.4.2"
  }
}
